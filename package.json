{
  "name": "bead-pattern-converter",
  "version": "1.0.0",
  "description": "AIpindou 拼豆图像转换桌面软件",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm.cmd run dev:frontend\" \"npm.cmd run dev:electron\"",
    "dev:frontend": "cd frontend && npm.cmd run dev -- --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:3000 && electron . --dev",
    "build": "npm.cmd run build:frontend",
    "build:frontend": "cd frontend && npm.cmd run build",
    "build:exe": "npm.cmd run build && electron-builder --win portable",
    "validate:palette": "node scripts/run_validate_palette_data.cjs",
    "test": "cd frontend && npm.cmd run test -- --run",
    "lint": "cd frontend && npm.cmd run lint"
  },
  "keywords": [
    "bead",
    "pattern",
    "converter",
    "perler",
    "hama",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.aipindou.converter",
    "productName": "AIpindou",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "AIpindou-${version}.${ext}"
    }
  }
}
