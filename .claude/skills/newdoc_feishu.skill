#!/usr/bin/env node

const { spawnSync } = require('node:child_process')
const fs = require('node:fs')
const path = require('node:path')

const script = path.join(
  process.env.USERPROFILE || '',
  '.codex',
  'skills',
  'newdoc-feishu',
  'scripts',
  'newdoc-feishu.js'
)

const args = process.argv.slice(2)
const normalizedArgs = args.length > 0 && !args[0].startsWith('--')
  ? ['--title', args[0], ...(args[1] && !args[1].startsWith('--') ? ['--file', args[1], ...args.slice(2)] : args.slice(1))]
  : args

const result = spawnSync(process.execPath, [script, ...normalizedArgs], {
  encoding: 'utf8',
  input: process.stdin.isTTY ? undefined : fs.readFileSync(0)
})

if (result.stdout) {
  process.stdout.write(result.stdout)
}
if (result.stderr) {
  process.stderr.write(result.stderr)
}

process.exit(result.status ?? 1)
