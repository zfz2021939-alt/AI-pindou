#!/usr/bin/env node

/**
 * newdoc_feishu skill - 创建飞书新文档并保存内容
 *
 * 功能：
 * 1. 检查飞书认证状态
 * 2. 自动登录飞书（如果需要）
 * 3. 创建新文档
 * 4. 保存内容到文档
 *
 * 使用方法：
 * /newdoc_feishu <文档标题> [内容来源]
 *
 * 参数：
 * - <文档标题>: 必需，文档标题
 * - [内容来源]: 可选，内容来源文件路径，默认从stdin读取
 *
 * 示例：
 * /newdoc_feishu "我的文档"
 * /newdoc_feishu "设计方案" design.md
 */

const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

// 检查认证状态
function checkAuthStatus() {
    try {
        const output = execSync('lark-cli auth status', { encoding: 'utf8' });
        return JSON.parse(output);
    } catch (error) {
        return null;
    }
}

// 确保认证
function ensureAuth() {
    const status = checkAuthStatus();

    if (!status || status.tokenStatus !== 'valid') {
        console.log('需要登录飞书...');
        execSync('lark-cli auth login --domain docs --recommend', { stdio: 'inherit' });
        console.log('认证完成！');
    } else {
        console.log(`已认证用户: ${status.userName}`);
    }
}

// 读取内容
function readContent(contentSource) {
    if (contentSource) {
        if (fs.existsSync(contentSource)) {
            return fs.readFileSync(contentSource, 'utf8');
        } else {
            throw new Error(`文件不存在: ${contentSource}`);
        }
    } else {
        // 从 stdin 读取
        let content = '';
        process.stdin.setEncoding('utf8');

        process.stdin.on('data', (chunk) => {
            content += chunk;
        });

        process.stdin.on('end', () => {
            return content;
        });

        // 同步等待输入（简化处理）
        return '';
    }
}

// 创建文档
function createDocument(title, content) {
    console.log(`正在创建文档: ${title}`);

    // 创建文档
    const createCmd = `lark-cli docs +create --title "${title}" --markdown "${escapeMarkdown(content)}" --wiki-space "my_library"`;
    const output = execSync(createCmd, { encoding: 'utf8' });
    const result = JSON.parse(output);

    console.log(`✅ 文档创建成功！`);
    console.log(`📄 文档URL: ${result.data.doc_url}`);
    console.log(`📝 文档ID: ${result.data.doc_id}`);

    return result.data;
}

// 转义Markdown特殊字符
function escapeMarkdown(content) {
    return content
        .replace(/\\/g, '\\\\')
        .replace(/`/g, '\\`')
        .replace(/\$/g, '\\$')
        .replace(/\n/g, '\\n')
        .replace(/"/g, '\\"');
}

// 主函数
function main() {
    const args = process.argv.slice(2);

    if (args.length === 0) {
        console.log('请提供文档标题');
        console.log('使用方法: newdoc_feishu <文档标题> [内容文件]');
        process.exit(1);
    }

    const title = args[0];
    const contentSource = args[1];

    try {
        // 1. 确保认证
        ensureAuth();

        // 2. 读取内容
        const content = readContent(contentSource);

        if (!content && !contentSource) {
            console.log('请提供文档内容（通过stdin或文件）');
            process.exit(1);
        }

        // 3. 创建文档
        const docInfo = createDocument(title, content);

        // 4. 返回结果
        console.log('\n🎉 任务完成！');
        process.stdout.write(JSON.stringify({
            success: true,
            doc_id: docInfo.doc_id,
            doc_url: docInfo.doc_url,
            title: title
        }));

    } catch (error) {
        console.error('❌ 创建文档失败:', error.message);
        process.stdout.write(JSON.stringify({
            success: false,
            error: error.message
        }));
        process.exit(1);
    }
}

// 如果直接运行此脚本
if (require.main === module) {
    main();
}

module.exports = { checkAuthStatus, ensureAuth, createDocument };